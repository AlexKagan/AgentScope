# Copy to .env and fill in real values. .env is git-ignored and never committed.
# AgentScope reads these with the AGENTSCOPE_ prefix.

# --- Public configuration (safe to share; shown here for convenience) ---
AGENTSCOPE_ARCHITECTURE_KEY=
AGENTSCOPE_PRIMARY_MODEL=
AGENTSCOPE_RUNTIME_MODE=fake
AGENTSCOPE_TELEMETRY_ENABLED=false
AGENTSCOPE_TELEMETRY_ENDPOINT=http://localhost:6006/v1/traces
AGENTSCOPE_LOG_LEVEL=INFO

# --- Secret configuration (real values only in .env) ---
AGENTSCOPE_OPENAI_API_KEY=REPLACE_ME
AGENTSCOPE_PHOENIX_API_KEY=REPLACE_ME
AGENTSCOPE_OTLP_HEADERS=REPLACE_ME
